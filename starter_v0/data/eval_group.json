{
  "dataset_id": "day04_v3_helpdesk_group",
  "dataset_role": "group",
  "description": "Group eval suite with exactly 10 IT helpdesk cases: 5 single-turn query cases and 5 multi-turn cases.",
  "allowed_failure_types": ["wrong_tool", "wrong_arg_value", "wrong_boundary", "unnecessary_tool", "out_of_scope", "missing_info"],
  "cases": [
    {
      "id": "G01",
      "phase": "B",
      "suite": "group",
      "query": "Kiểm tra Wi-Fi trên laptop của nhân viên thiết kế ở tầng 3 giúp mình.",
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "text"
            }
          }
        ]
      },
      "metadata": {
        "skill": "missing_asset_identifier",
        "difficulty": "medium",
        "what_it_tests": "Thiếu asset ID cụ thể thì phải hỏi lại, không tự đoán từ phòng ban hoặc địa điểm."
      }
    },
    {
