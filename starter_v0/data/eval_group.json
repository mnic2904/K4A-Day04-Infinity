          }
        ]
      },
      "metadata": {
        "skill": "format_only_without_refetch",
        "difficulty": "hard",
        "what_it_tests": "Khi findings đã có sẵn và user nói không kiểm tra lại, agent chỉ format report và không gọi inspect/status."
