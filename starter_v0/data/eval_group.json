      "phase": "B",
      "suite": "group",
      "query": "Kiểm tra email ở môi trường demo của team QA.",
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "choice",
              "options": [
                "production",
                "staging"
              ]
            }
          }
        ]
      },
      "metadata": {
        "skill": "ambiguous_environment",
        "difficulty": "hard",
        "what_it_tests": "Môi trường demo không nằm trong enum production/staging nên agent phải hỏi lại thay vì tự map."
      }
    },
    {
      "id": "G03",
      "phase": "B",
      "suite": "group",
      "query": "So sánh trạng thái SSO production và staging, đừng bỏ sót môi trường nào.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "check_service_status",
            "args": {
              "service": "sso",
              "environment": "production"
            }
          },
          {
            "name": "check_service_status",
            "args": {
              "service": "sso",
              "environment": "staging"
            }
          }
        ]
      },
      "metadata": {
        "skill": "duplicate_status_tool_calls",
        "difficulty": "hard",
        "what_it_tests": "Cùng một tool phải được gọi hai lần với args khác nhau khi user yêu cầu so sánh hai môi trường."
      }
    },
    {
      "id": "G04",
      "phase": "B",
      "suite": "group",
      "query": "So sánh hardware snapshot của máy in PR-404 và phòng họp RM-501.",
