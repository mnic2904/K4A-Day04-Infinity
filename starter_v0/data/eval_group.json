      "expect": {
        "tool_calls": [
          {
            "name": "inspect_device",
            "args": {
              "asset_id": "PR-404",
              "check": "hardware"
            }
          },
          {
            "name": "inspect_device",
            "args": {
              "asset_id": "RM-501",
              "check": "hardware"
            }
          }
        ]
      },
      "metadata": {
        "skill": "multiple_assets",
        "difficulty": "hard",
        "what_it_tests": "Không gộp hai asset vào một argument và không chỉ kiểm tra một asset khi user yêu cầu so sánh hai asset."
      }
    },
    {
